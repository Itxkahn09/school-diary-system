<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>School Diary - Admin Panel</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
}

body{
  background:#f3f7fc;
  color:#172033;
}

.header{
  background:white;
  padding:20px;
  box-shadow:0 3px 15px rgba(0,0,0,.08);
}

.header h1{
  color:#1769e0;
  font-size:24px;
}

.header p{
  color:#667085;
  margin-top:5px;
}

.container{
  max-width:900px;
  margin:25px auto;
  padding:0 15px;
}

.card{
  background:white;
  border-radius:16px;
  padding:22px;
  margin-bottom:20px;
  box-shadow:0 6px 25px rgba(30,80,150,.09);
}

h2{
  margin-bottom:18px;
}

label{
  display:block;
  font-weight:bold;
  margin:14px 0 7px;
}

input,select{
  width:100%;
  padding:13px;
  border:1px solid #d6deea;
  border-radius:9px;
  font-size:15px;
  background:white;
}

button{
  border:0;
  padding:13px 18px;
  border-radius:9px;
  background:#1769e0;
  color:white;
  font-weight:bold;
  font-size:15px;
  cursor:pointer;
  margin-top:18px;
}

button:hover{
  background:#0f58c5;
}

.teacher-list{
  display:grid;
  gap:12px;
  margin-top:15px;
}

.teacher{
  border:1px solid #dce3ed;
  border-radius:12px;
  padding:15px;
  background:#fafcff;
}

.teacher-name{
  font-weight:bold;
  font-size:17px;
}

.allocation{
  margin-top:8px;
  color:#667085;
  line-height:1.7;
}

.delete{
  background:#dc2626;
  margin-top:10px;
}

.delete:hover{
  background:#b91c1c;
}

.empty{
  color:#667085;
  text-align:center;
  padding:15px;
}
</style>
</head>

<body>

<header class="header">
  <h1>⚙️ School Diary Admin</h1>
  <p>Teacher & Class Allocation Management</p>
</header>

<main class="container">

<div class="card">

  <h2>👨‍🏫 Add Teacher</h2>

  <label>Teacher Name *</label>
  <input id="teacherName" placeholder="e.g. Muhammad Hassan">

  <button onclick="addTeacher()">
    ➕ Add Teacher
  </button>

</div>


<div class="card">

  <h2>🏫 Add Class Allocation</h2>

  <label>Select Teacher *</label>
  <select id="teacherSelect">
    <option value="">Select teacher</option>
  </select>

  <label>Class & Section *</label>
  <input id="className" placeholder="e.g. 6-A">

  <label>Subject *</label>
  <input id="subject" placeholder="e.g. English">

  <label>Shift *</label>
  <select id="shift">
    <option value="Morning">Morning</option>
    <option value="Evening">Evening</option>
    <option value="Higher">Higher</option>
  </select>

  <button onclick="addAllocation()">
    ➕ Add Allocation
  </button>

</div>


<div class="card">

  <h2>📋 Current Teachers & Allocations</h2>

  <div id="teacherList" class="teacher-list"></div>

</div>

</main>


<script>

let teachers =
JSON.parse(localStorage.getItem("schoolTeachers")) || [];


function saveData(){

  localStorage.setItem(
    "schoolTeachers",
    JSON.stringify(teachers)
  );

}


function refreshTeacherSelect(){

  const select =
    document.getElementById("teacherSelect");

  select.innerHTML =
    '<option value="">Select teacher</option>';

  teachers.forEach((teacher,index)=>{

    const option =
      document.createElement("option");

    option.value=index;
    option.textContent=teacher.name;

    select.appendChild(option);

  });

}


function refreshTeacherList(){

  const list =
    document.getElementById("teacherList");

  list.innerHTML="";

  if(teachers.length===0){

    list.innerHTML =
      '<div class="empty">No teachers added yet.</div>';

    return;

  }

  teachers.forEach((teacher,index)=>{

    const div =
      document.createElement("div");

    div.className="teacher";

    let allocations="";

    if(teacher.allocations.length===0){

      allocations="No class allocation yet.";

    }else{

      allocations =
        teacher.allocations.map(a =>

          `🏫 <b>${a.class}</b> — ${a.subject}
           — ${a.shift}`

        ).join("<br>");

    }

    div.innerHTML=`

      <div class="teacher-name">
        👨‍🏫 ${teacher.name}
      </div>

      <div class="allocation">
        ${allocations}
      </div>

      <button
        class="delete"
        onclick="deleteTeacher(${index})">
        🗑️ Delete Teacher
      </button>

    `;

    list.appendChild(div);

  });

}


function addTeacher(){

  const name =
    document
    .getElementById("teacherName")
    .value.trim();

  if(!name){

    alert("Please enter teacher name.");

    return;

  }

  teachers.push({

    name:name,

    allocations:[]

  });

  saveData();

  document
    .getElementById("teacherName")
    .value="";

  refreshTeacherSelect();
  refreshTeacherList();

  alert("Teacher added successfully!");

}


function addAllocation(){

  const teacherIndex =
    document
    .getElementById("teacherSelect")
    .value;

  const className =
    document
    .getElementById("className")
    .value.trim();

  const subject =
    document
    .getElementById("subject")
    .value.trim();

  const shift =
    document
    .getElementById("shift")
    .value;


  if(
    teacherIndex==="" ||
    !className ||
    !subject
  ){

    alert("Please complete all fields.");

    return;

  }


  teachers[teacherIndex]
    .allocations
    .push({

      class:className,
      subject:subject,
      shift:shift

    });


  saveData();

  document
    .getElementById("className")
    .value="";

  document
    .getElementById("subject")
    .value="";

  refreshTeacherList();

  alert("Class allocation added!");

}


function deleteTeacher(index){

  if(
    confirm(
      "Are you sure you want to delete this teacher?"
    )
  ){

    teachers.splice(index,1);

    saveData();

    refreshTeacherSelect();
    refreshTeacherList();

  }

}


refreshTeacherSelect();
refreshTeacherList();

</script>

</body>
</html>
